PORT=3001
NODE_ENV=development

# Security
# Comma-separated allowlist. Example: http://localhost:5173,https://your-site.netlify.app
CORS_ORIGIN=
# Used to access /debug/database in production. Send it as header x-debug-token.
DEBUG_TOKEN=

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fishingapp
DB_USER=postgres
DB_PASSWORD=your_password

# API Keys (se necessário)
WEATHER_API_KEY=your_weather_api_key

# WorldTides (used by /api/tides/current)
WORLDTIDES_KEY=your_worldtides_key
